      </connection>
      <aliases enabled='yes' />
      <column caption='Actual Arrival' datatype='date' name='[ActualArrival]' role='dimension' type='ordinal' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([ShipmentValue])) - LOOKUP(ZN(SUM([ShipmentValue])), -1)) / ABS(LOOKUP(ZN(SUM([ShipmentValue])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Supplier Rank' datatype='integer' name='[Calculation_0144898923429891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([ShipmentValue]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top N Filter' datatype='boolean' name='[Calculation_0144898927267846]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() &lt;= [Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Selected Metric' datatype='integer' name='[Calculation_0144898929242119]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;&#13;&#10;WHEN &quot;Shipment Value&quot; THEN SUM([ShipmentValue])&#13;&#10;WHEN &quot;Units&quot; THEN SUM([Units])&#13;&#10;WHEN &quot;Weight KG&quot; THEN SUM([Weight_KG])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Delay Status' datatype='string' name='[Calculation_0144898930647048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0670465313918976] &gt; [Parameters].[Parameter 3]&#13;&#10;THEN &quot;Exceeded&quot;&#13;&#10;ELSE &quot;Within Limit&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Revenue' datatype='integer' name='[Calculation_0144898932555785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ShipmentValue])' />
      </column>
      <column caption='Last Month Revenue' datatype='integer' name='[Calculation_0144898932699146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(SUM([ShipmentValue]),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Revenue % Change' datatype='real' default-format='p0.00%' name='[Calculation_0144898932862987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([ShipmentValue]) - LOOKUP(SUM([ShipmentValue]),-1))&#13;&#10;/&#13;&#10;LOOKUP(SUM([ShipmentValue]),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Shipments' datatype='integer' name='[Calculation_0144898940588047]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([ShipmentID])' />
      </column>
      <column caption='On-Time Delivery Rate' datatype='real' name='[Calculation_0144898945339410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_0670465315803137] = &quot;Yes&quot; THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([ShipmentID])' />
      </column>
      <column caption='Delay Days KPI' datatype='integer' name='[Calculation_0144898947436563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [ActualArrival] &gt; [EstimatedArrival]&#13;&#10;THEN DATEDIFF(&apos;day&apos;,[EstimatedArrival],[ActualArrival])&#13;&#10;END' />
      </column>
      <column caption='Avg Delay Days' datatype='real' name='[Calculation_0144898947993620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_0144898947436563])' />
      </column>
      <column caption='Route' datatype='string' name='[Calculation_0396687135662080]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[OriginPort] + &quot; → &quot; + [DestinationPort]' />
      </column>
      <column caption='Path Order' datatype='integer' name='[Calculation_0396687137005569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Duration' datatype='integer' name='[Calculation_0396687152877574]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [ShipDate], [ActualArrival])' />
      </column>
      <column caption='Delivery_Delay' datatype='integer' name='[Calculation_0670465313918976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[EstimatedArrival],[ActualArrival])' />
      </column>
      <column caption=' On_Time_Flag' datatype='string' name='[Calculation_0670465315803137]' role='dimension' semantic-role='' type='nominal'>
        <calculation class='tableau' formula='IF [ActualArrival] &lt;= [EstimatedArrival]&#13;&#10;THEN &quot;Yes&quot;&#13;&#10;ELSE &quot;No&quot;&#13;&#10;END' />
      </column>
      <column caption='Profit_Margin' datatype='real' name='[Calculation_0670465316880386]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([OrderValue] - [ShipmentValue])/[OrderValue]' />
      </column>
      <column caption='Average_Shipment' datatype='real' name='[Calculation_0670465317306371]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([ShipmentValue])' />
      </column>
      <column caption='YTD_Revenue' datatype='integer' name='[Calculation_0670465317482500]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([OrderValue]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Supplier_Performanc_ Score' datatype='real' name='[Calculation_0670465318223877]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([OnTimeDeliveryRate] * 0.4) + ([RatingScore]/5 * 0.3) + (IF [Status]=&quot;Delivered&quot; THEN 0.3 ELSE 0 END)' />
      </column>
      <column caption='Inventory_Turnover' datatype='real' name='[Calculation_0670465318580230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[CurrentStock] / [ReorderPoint]' />
      </column>
      <column caption='Days_of_Stock' datatype='real' name='[Calculation_0670465318694919]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([CurrentStock]) / (SUM([Quantity]) / 90)' />
      </column>
      <column caption='Revenue_per_KG' datatype='real' name='[Calculation_0670465320964104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[ShipmentValue] / [Weight_KG]' />
      </column>
      <column caption='Category_Concentration' datatype='real' name='[Calculation_0670465321086985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(SUM([OrderValue])) / TOTAL(SUM([OrderValue]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Stock Change' datatype='integer' name='[Calculation_0675413413691392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([CurrentStock]) - LOOKUP(SUM([CurrentStock]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Running Stock' datatype='integer' name='[Calculation_0714171204890624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([Calculation_0675413413691392])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Hight' datatype='integer' name='[Calculation_0714171208454147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([StockValue])' />
      </column>
      <column caption='Contract Start Date' datatype='date' name='[ContractStartDate]' role='dimension' type='ordinal' />
