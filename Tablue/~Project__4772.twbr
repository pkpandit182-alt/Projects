    <worksheet name='Total Revenue (with vs last month %)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Shipments+ (Tablue)' name='federated.0lw3apo0r3o02u14erkb9009fqa8' />
          </datasources>
          <datasource-dependencies datasource='federated.0lw3apo0r3o02u14erkb9009fqa8'>
            <column caption='Total Revenue' datatype='integer' name='[Calculation_0144898932555785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ShipmentValue])' />
            </column>
            <column caption='Revenue % Change' datatype='real' default-format='p0.00%' name='[Calculation_0144898932862987]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ShipmentValue]) - LOOKUP(SUM([ShipmentValue]),-1))&#13;&#10;/&#13;&#10;LOOKUP(SUM([ShipmentValue]),-1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Shipment Value' datatype='integer' name='[ShipmentValue]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0144898932555785]' derivation='User' name='[usr:Calculation_0144898932555785:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0144898932862987]' derivation='User' name='[usr:Calculation_0144898932862987:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
            </column-instance>
