            <column caption='Delay Days KPI' datatype='integer' name='[Calculation_0144898947436563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [ActualArrival] &gt; [EstimatedArrival]&#13;&#10;THEN DATEDIFF(&apos;day&apos;,[EstimatedArrival],[ActualArrival])&#13;&#10;END' />
